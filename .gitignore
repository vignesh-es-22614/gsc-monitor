# Credentials never belong in the repo. In CI the token is materialised from
# the GSC_TOKEN_JSON secret and deleted again at the end of the job.
gsc_token.json
*client_secret*.json
bigquery_token.json

__pycache__/
*.pyc
.venv/

# Local digest preview written by "alerts.py --preview"; never published.
docs/_digest_preview.html

# The generated payload is ~126 MB per build -- every page and every query, at
# three windows, for fourteen properties. Committing it daily would add tens of
# gigabytes of repo churn a year, so the Action builds it and publishes it
# straight to Pages as an artifact instead. Rebuild locally with:
#   python build_payload.py --out docs/data --api-fallback
docs/data/

# Local CSV extracts from export_data.py.
exports/
